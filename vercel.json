{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/seo.js": {
      "includeFiles": "huagui_company_site/{*.html,assets/js/*.js,data/products.json}"
    },
    "api/sitemap.js": {
      "includeFiles": "huagui_company_site/data/products.json"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/huagui_company_site/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)",
      "destination": "/api/seo?locale=:locale&page=index"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)/products/:slug",
      "destination": "/api/seo?locale=:locale&page=product&slug=:slug"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/seo?locale=en&page=product&slug=:slug"
    },
    {
      "source": "/product-detail.html",
      "destination": "/api/seo?locale=en&page=product"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)/:page.html",
      "destination": "/api/seo?locale=:locale&page=:page"
    },
    {
      "source": "/admin",
      "destination": "/huagui_company_site/admin.html"
    },
    {
      "source": "/data/(.*)",
      "destination": "/huagui_company_site/data/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/huagui_company_site/uploads/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/huagui_company_site/assets/$1"
    },
    {
      "source": "/:page(index|products|service|factory|exhibitions|faq|about|contact|privacy).html",
      "destination": "/api/seo?locale=en&page=:page"
    },
    {
      "source": "/",
      "destination": "/api/seo?locale=en&page=index"
    },
    {
      "source": "/(.*)",
      "destination": "/huagui_company_site/$1"
    }
  ]
}
