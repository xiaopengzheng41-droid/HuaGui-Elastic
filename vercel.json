{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/huagui_company_site/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)",
      "destination": "/huagui_company_site/index.html"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)/products/:slug",
      "destination": "/huagui_company_site/product-detail.html?slug=:slug"
    },
    {
      "source": "/products/:slug",
      "destination": "/huagui_company_site/product-detail.html?slug=:slug"
    },
    {
      "source": "/:locale(es|pt-br|ru|ar)/:page.html",
      "destination": "/huagui_company_site/:page.html"
    },
    {
      "source": "/admin",
      "destination": "/huagui_company_site/admin.html"
    },
    {
      "source": "/data/(.*)",
      "destination": "/huagui_company_site/data/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/huagui_company_site/uploads/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/huagui_company_site/assets/$1"
    },
    {
      "source": "/(.*).html",
      "destination": "/huagui_company_site/$1.html"
    },
    {
      "source": "/",
      "destination": "/huagui_company_site/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/huagui_company_site/$1"
    }
  ]
}
