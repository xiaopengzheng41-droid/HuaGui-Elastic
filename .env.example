ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# Optional. Defaults to 12 hours.
ADMIN_SESSION_MAX_AGE_SECONDS=43200

# Vercel Blob. Production usually gets BLOB_STORE_ID from the connected Blob store.
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# Optional legacy Blob auth token.
BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token

# Optional. Defaults to cms/products.json.
CMS_PRODUCTS_BLOB_PATH=cms/products.json

# Customer inquiries must use a separate Private Blob store.
# Vercel CLI with `--prefix INQUIRIES` creates INQUIRIES_STORE_ID.
INQUIRIES_STORE_ID=store_xxxxxxxxxxxxxxxx
# Legacy/manual alias also supported by the application:
# INQUIRIES_BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# Optional when the private store uses a legacy read/write token instead of OIDC.
INQUIRIES_BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token
# Optional. Defaults to inquiries.
INQUIRIES_BLOB_PREFIX=inquiries

# Consent-gated website measurement. The public Pixel ID is returned by
# /api/public-config only when it matches Meta's numeric ID format.
META_PIXEL_ID=000000000000000
# Dataset used by the Conversions API. For browser/server event deduplication,
# this MUST be the same web data source ID as META_PIXEL_ID.
META_DATASET_ID=000000000000000
# Secret server-side token. Never expose this value in browser code.
META_CAPI_ACCESS_TOKEN=replace-with-events-manager-token
# Pin the Graph API version shown by Meta when the data source is configured.
META_GRAPH_API_VERSION=vXX.X
# Optional during Events Manager validation; remove after the test is complete.
META_TEST_EVENT_CODE=
